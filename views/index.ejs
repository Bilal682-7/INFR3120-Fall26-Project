<!-- Landing page: site name, team logo, hero button and a table of recent workouts -->
<%- include('partials/header', { title: title }) %>

<!-- Hero section: the main button here lets the user create a new workout -->
<section class="hero">
  <img class="hero-logo" src="/images/logo.png" alt="LiftLog team logo" width="120" height="120">
  <h1>LiftLog</h1>
  <p class="tagline">Track your workouts. See your progress.</p>
  <a class="btn btn-hero" href="/workouts/new">Log a Workout</a>
</section>

<!-- The 20 most recent workouts, read from MongoDB by routes/index.js -->
<section>
  <h2>Recent Workouts</h2>
  <%- include('partials/workoutTable', { workouts: workouts }) %>
</section>

<%- include('partials/footer') %>